# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Service role key is required for admin/bypass actions like updating lockouts
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Supabase JWT Secret (needed to verify JWTs locally)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

KIE_BASE_URL=http://KIE_BASE_URL
KIE_AI2_BASE_URL=http://KIE_AI2_BASE_URL

KIE_WEBHOOK_SECRET=placeholder-kie-secret
 
# Cashfree Payment Gateway (Sandbox vs Production)
CASHFREE_ENV=sandbox
CASHFREE_PG_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=http://localhost:3000/billing/return
CASHFREE_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/cashfree